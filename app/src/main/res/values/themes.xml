<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme -->
    <style name="Base.Theme.CinemaHub" parent="@android:style/Theme.Material">
        <!-- Primary brand color -->
        <item name="android:colorPrimary">@color/primary_red</item>
        <item name="android:colorPrimaryDark">@color/primary_red_dark</item>
        <item name="android:colorAccent">@color/primary_red</item>

        <!-- Status bar styling -->
        <item name="android:statusBarColor">@color/background_primary</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Navigation bar styling -->
        <item name="android:navigationBarColor">@color/navigation_bar_color</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Window background -->
        <item name="android:windowBackground">@color/background_primary</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Text colors -->
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorTertiary">@color/text_tertiary</item>
    </style>

    <style name="Theme.CinemaHub" parent="Base.Theme.CinemaHub" />

    <!-- Text Styles -->
    <style name="TextAppearance.CinemaHub" parent="@android:style/TextAppearance">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.CinemaHub.Headline1">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.CinemaHub.Headline2">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.CinemaHub.Headline3">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.CinemaHub.Headline4">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.CinemaHub.Headline5">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.CinemaHub.Headline6">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.CinemaHub.Subtitle1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.CinemaHub.Subtitle2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.CinemaHub.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="TextAppearance.CinemaHub.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="TextAppearance.CinemaHub.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="TextAppearance.CinemaHub.Overline">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Base custom widget style, used by all CinemaHub widget styles. -->
<style name="Widget.CinemaHub" parent=""/>

    <!-- Button Styles -->
    <style name="Widget.CinemaHub.Button" parent="@android:style/Widget.Button">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@color/button_enabled</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.CinemaHub.Button.Outlined">
        <item name="android:textColor">@color/primary_red</item>
        <item name="android:background">@drawable/button_outlined_background</item>
    </style>

    <style name="Widget.CinemaHub.Button.Text">
        <item name="android:textColor">@color/primary_red</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- EditText Styles -->
    <style name="Widget.CinemaHub.EditText" parent="@android:style/Widget.EditText">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:background">@drawable/edittext_background</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Card Styles -->
    <style name="Widget.CinemaHub.Card">
        <item name="android:background">@color/card_background</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- Rating Bar -->
    <style name="Widget.CinemaHub.RatingBar" parent="@android:style/Widget.RatingBar">
        <item name="android:progressDrawable">@drawable/ratingbar_drawable</item>
    </style>

    <!-- Progress Bar -->
    <style name="Widget.CinemaHub.ProgressBar" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progressbar_drawable</item>
    </style>

    <!-- Divider -->
    <style name="Widget.CinemaHub.Divider">
        <item name="android:background">@color/divider_light</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_width">match_parent</item>
    </style>

    <!-- Dialog Styles -->
    <style name="AlertDialog.CinemaHub" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@color/background_secondary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorAccent">@color/primary_red</item>
    </style>

    <!-- Popup Menu -->
    <style name="PopupMenu.CinemaHub" parent="@android:style/Theme.Material">
        <item name="android:windowBackground">@color/background_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.CinemaHub.ToolBar" parent="@android:style/Widget.Holo.Light.ActionBar">
        <item name="android:background">@color/background_secondary</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- Custom Shape Styles -->
    <style name="Widget.CinemaHub.Rounded">
        <item name="android:background">@drawable/rounded_background</item>
    </style>

    <style name="Widget.CinemaHub.Rounded.Small">
        <item name="android:background">@drawable/rounded_background_small</item>
    </style>

    <style name="Widget.CinemaHub.Rounded.Large">
        <item name="android:background">@drawable/rounded_background_large</item>
    </style>

    <!-- NoActionBar Theme -->
    <style name="Theme.CinemaHub.NoActionBar" parent="Theme.CinemaHub">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Fullscreen Theme -->
    <style name="Theme.CinemaHub.Fullscreen" parent="Theme.CinemaHub.NoActionBar">
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Translucent Theme -->
    <style name="Theme.CinemaHub.Translucent" parent="Theme.CinemaHub.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
</resources>
