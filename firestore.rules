rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /movieReviews/{reviewId} {
      // Clients must use Firebase Authentication; the app signs users in anonymously.
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && reviewId == '${request.resource.data.movieId}_${request.auth.uid}'
        && request.resource.data.keys().hasOnly([
          'movieId', 'userId', 'authorName', 'rating', 'comment', 'createdAt'
        ])
        && request.resource.data.movieId is int
        && request.resource.data.movieId > 0
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 40
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 1
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.movieId == resource.data.movieId
        && request.resource.data.movieId is int
        && reviewId == '${request.resource.data.movieId}_${request.auth.uid}'
        && request.resource.data.keys().hasOnly([
          'movieId', 'userId', 'authorName', 'rating', 'comment', 'createdAt'
        ])
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 1
        && request.resource.data.authorName.size() <= 40
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 1
        && request.resource.data.comment.size() <= 1000
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
